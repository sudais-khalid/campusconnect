{
  "name": "campusconnect",
  "version": "0.1.0",
  "private": true,
  "description": "Smart campus complaint and feedback management system",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "docs:build": "node scripts/build-docs.mjs",
    "postinstall": "prisma generate",
    "icons": "node scripts/generate-icons.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.0.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.3.0",
    "file-type": "^21.0.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "nodemailer": "^7.0.0",
    "pino": "^9.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^4.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "uqr": "^0.1.3",
    "uuid": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudais-khalid/campusconnect.git"
  },
  "homepage": "https://campusconnect-delta-topaz.vercel.app",
  "author": "Sudais Khalid and Farooq Khan"
}
